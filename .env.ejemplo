USAR_SIMULACION=false
LLM_URL=http://localhost:1234/v1
# id del modelo tal como aparece en LM Studio
LLM_MODELO=qwen/qwen3-4b-2507
# Al cargar el modelo en LM Studio:
# - sube el "Context Length" a 16384: el moderador recibe el contexto de los 3 agentes
#   + documentos RAG y con 8192 corta con "exceed_context_size_error".
# - deja "Max Concurrent Predictions" en 1: con mas predicciones a la vez el contexto
#   se puede repartir entre ellas y vuelve el error de contexto.
# - antes de analizar, revisa que el servidor de LM Studio este encendido
#   (pestaña Developer -> Start Server, o "lms server start"); si no, la demo
#   muestra un error de conexion.
# - si el PC tiene GPU, sube "GPU Offload" al maximo y activa "Flash Attention":
#   es lo que mas acelera las respuestas.
# En CPU, una respuesta larga puede demorar bastante: 3600s (1h) da margen suficiente.
LLM_TIMEOUT=3600
# Tope de tokens de cada respuesta: evita que el modelo se alargue de mas.
LLM_MAX_TOKENS=3000
# Fragmentos de documentos que busca cada agente (menos = prompt mas corto y rapido).
K_FRAGMENTOS=3
# Largo maximo de cada fragmento en el prompt, en caracteres (se corta en un espacio).
MAX_CARACTERES_FRAGMENTO=1200
