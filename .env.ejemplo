USAR_SIMULACION=false
LLM_URL=http://localhost:1234/v1
LLM_MODELO=qwen3-4b
# El moderador recibe el contexto de los 3 agentes + documentos RAG y puede superar
# los 11.000 tokens: en LM Studio, al cargar el modelo, sube el "Context Length" a
# 16384 (8192 no alcanza y corta con "exceed_context_size_error").
# En CPU, una respuesta larga puede demorar bastante: 3600s (1h) da margen suficiente.
LLM_TIMEOUT=3600